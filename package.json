{
  "name": "vastworld",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "VastWorld M0 工程基线：pnpm workspace + 统一 lint/typecheck/test/build",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "db:test": "node supabase/tests/run-local.mjs",
    "dev": "pnpm --parallel -r run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:dev": "pnpm --filter @vastworld/web dev",
    "web:build": "pnpm --filter @vastworld/web build",
    "web:preview": "pnpm --filter @vastworld/web preview",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@electric-sql/pglite": "0.5.4",
    "@vastworld/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
