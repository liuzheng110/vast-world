# 复制为 .env 后填入本地值。本文件只列变量名和用途，绝不包含真实密钥。
# 生产密钥只存在于部署平台/密钥管理服务中，不进入代码库（AGENTS.md §2）。

# ---- apps/web：浏览器可见的 Supabase 项目公钥 ----
# Supabase 项目 URL
VITE_SUPABASE_URL=
# Supabase publishable/anon key（可安全暴露给浏览器）
VITE_SUPABASE_ANON_KEY=

# ---- apps/game-server：仅服务端持有 ----
# 游戏服务监听端口
GAME_SERVER_PORT=2567
# PostgreSQL/Supabase 连接字符串（仅服务端，禁止出现在前端或日志中）
DATABASE_URL=
# Supabase service_role 密钥（仅服务端密钥管理，禁止进前端、PR 或录屏）
SUPABASE_SERVICE_ROLE_KEY=
