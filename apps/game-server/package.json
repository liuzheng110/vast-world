{
  "name": "@vastworld/game-server",
  "version": "0.0.0",
  "private": true,
  "description": "VastWorld 权威游戏服务（Colyseus）",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "vastworld-game-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:source": "node --import tsx src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/ws-transport": "^0.18.4",
    "@vastworld/game-core": "workspace:*",
    "@vastworld/protocol": "workspace:*",
    "express": "^5.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "@vastworld/config": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
