{
  "name": "@vastworld/protocol",
  "version": "0.0.0",
  "private": true,
  "description": "VastWorld 共享网络协议：握手、版本号、消息类型与错误码",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vastworld/config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
