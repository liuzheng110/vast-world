{
  "name": "@vastworld/game-core",
  "version": "0.0.0",
  "private": true,
  "description": "可在无渲染环境测试的纯游戏规则，不依赖 Phaser、React、Colyseus 或数据库",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@vastworld/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vastworld/config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
